# NOTE: GitHub Pages is served by GitHub's own edge servers (not Apache),
# so this file has NO EFFECT while hosted on github.io / GitHub Pages.
# It activates automatically if this site is ever moved to an Apache host
# (cPanel, shared hosting, etc.). Kept here so the config travels with the repo.

# ---- HTTPS + canonical host enforcement ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force non-www -> www is NOT assumed; adjust to your canonical domain if you add a custom domain
  # RewriteCond %{HTTP_HOST} ^www\.example\.com [NC]
  # RewriteRule ^(.*)$ https://example.com/$1 [L,R=301]
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; media-src 'self' https://anchortelecoms.com; frame-ancestors 'self'"
</IfModule>

# ---- Disable directory listing ----
Options -Indexes

# ---- Block access to hidden/system files ----
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml application/xml application/xhtml+xml text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# ---- Browser caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 1 day"
</IfModule>

# ---- Custom error page (optional) ----
# ErrorDocument 404 /404.html
